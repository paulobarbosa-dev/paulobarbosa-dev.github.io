---
import type { Locale } from '../i18n/content'
import { content } from '../i18n/content'
import Header from './Header.astro'
import Panel from './Panel.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = content[locale]
const words = (s: string) => s.split(' ')
const arrowUpRight = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M8 7h9v9"></path></svg>'
const decimal = locale === 'pt' ? ',' : '.'
---

<a class="skip" href="#conteudo">{t.ui.skip}</a>
<Header locale={locale} />

<main id="conteudo">
  <!-- Hero -->
  <section id="topo" class="hero dots">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="hero-fade" aria-hidden="true"></div>
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <div class="hero-titles">
          <p class="hello"><span class="mask"><span data-hero="hello">{t.hero.hello}</span></span></p>
          <h1 class="h1">
            <span class="h1-line">{words(t.hero.title[0]).map((w, i) => <>{i > 0 && ' '}<span class="mask"><span data-hero="word">{w}</span></span></>)}</span>
            <span class="h1-line accent">{words(t.hero.title[1]).map((w, i) => <>{i > 0 && ' '}<span class="mask"><span data-hero="word">{w}</span></span></>)}</span>
          </h1>
        </div>
        <p class="hero-sub" data-reveal data-hero="sub">{t.hero.subtitle}<span>{t.hero.subtitleStrong}</span>.</p>
        <div class="ctas">
          <a href="#projetos" class="btn btn-primary" data-reveal data-hero="cta">
            {t.hero.cta1}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12l7 7 7-7"></path></svg>
          </a>
          <a href="#contato" class="btn btn-ghost" data-reveal data-hero="cta">{t.hero.cta2}</a>
        </div>
      </div>
      <div data-reveal data-hero="panel">
        <Panel locale={locale} />
      </div>
    </div>
  </section>

  <!-- Marquee -->
  <div class="marquee" aria-label={t.marqueeLabel} data-marquee>
    <div class="marquee-track mono" data-marquee-track>
      {[0, 1].map((copy) => (
        <div class="marquee-group" aria-hidden={copy === 1 ? 'true' : undefined}>
          {t.marquee.map((item) => (
            <>
              <span>{item}</span>
              <span class="sep">·</span>
            </>
          ))}
        </div>
      ))}
    </div>
  </div>

  <!-- Impact -->
  <section id="impacto" class="section" data-impact>
    <div class="wrap stack-48">
      <h2 class="impact-title" data-reveal data-impact-title>{t.impact.title[0]}<span>{t.impact.title[1]}</span></h2>
      <div class="impact-grid">
        <div class="impact-card" data-reveal data-impact-card>
          <span class="num mono" data-num="87" data-format="int">87</span>
          <span class="desc">{t.impact.items[0]}</span>
        </div>
        <div class="impact-card" data-reveal data-impact-card>
          <span class="num mono" data-num="1000000" data-format="tilde">~1M</span>
          <span class="desc">{t.impact.items[1]}</span>
        </div>
        <div class="impact-card" data-reveal data-impact-card>
          <span class="num mono"><span data-num="500" data-format="int">500</span>k<b>+</b></span>
          <span class="desc">{t.impact.items[2]}</span>
        </div>
        <div class="impact-card" data-reveal data-impact-card>
          <span class="num mono nowrap"><span class="was">40</span><b>→</b><span data-num="5" data-from="40" data-format="int">5</span><small> min</small></span>
          <span class="desc">{t.impact.items[3]}</span>
        </div>
        <div class="impact-card" data-reveal data-impact-card>
          <span class="num mono nowrap">−<span data-num="49.5" data-format="dec" data-decimal={decimal}>{`49${decimal}5`}</span><em>%</em></span>
          <span class="desc">{t.impact.items[4]}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Projects -->
  <section id="projetos" class="section projects">
    <div class="wrap projects-inner">
      <div class="head" data-section-head>
        <span class="eyebrow" data-reveal data-head="label">{t.projects.label}</span>
        <h2 class="h2" data-reveal data-head="title">{t.projects.title}</h2>
        <p class="lead" data-reveal data-head="title">{t.projects.subtitle}</p>
      </div>

      {t.projects.list.map((p) => (
        <article class="project" data-reveal data-project>
          <div class="project-glow" aria-hidden="true"></div>
          <div class="project-copy">
            <div class="kind mono" data-reveal data-item><span class="n">{p.num}</span><span class="dash"></span><span>{p.kind}</span></div>
            <h3 data-reveal data-item>{p.name}</h3>
            <p class="project-desc" data-reveal data-item>{p.description}</p>
            <div class="decisions">
              <span class="decisions-label mono" data-reveal data-item>{t.projects.decisions}</span>
              <ul>
                {p.decisions.map((d) => (
                  <li data-reveal data-item><span class="arrow">→</span><span>{d}</span></li>
                ))}
              </ul>
            </div>
            <ul class="chips">
              {p.stack.map((s) => <li class="chip" data-reveal data-tag>{s}</li>)}
            </ul>
            <div class="links">
              {p.links.map((l) => (
                <a href={l.href} class="link" target="_blank" rel="noopener" data-reveal data-item>{l.label} <Fragment set:html={arrowUpRight} /></a>
              ))}
            </div>
          </div>
          {p.media.type === 'browser' ? (
            <div class="media browser" data-reveal data-media>
              <div class="browser-bar mono">
                <div class="win"><span></span><span></span><span></span></div>
                <span class="url">{p.media.url}</span>
              </div>
              <div class="browser-shot" data-parallax-box>
                <img src={p.media.image} alt={p.media.alt} loading="lazy" decoding="async" width="1600" height="1000" data-parallax />
              </div>
            </div>
          ) : (
            <div class="media phones dots" data-reveal data-media>
              {p.media.images.map((img, i) => (
                <div class={`phone ${i === 1 ? 'mid' : ''}`} data-parallax>
                  <img src={img.src} alt={img.alt} loading="lazy" decoding="async" width="600" height="1299" />
                </div>
              ))}
            </div>
          )}
        </article>
      ))}
    </div>
  </section>

  <!-- Experience -->
  <section id="experiencia" class="section">
    <div class="wrap exp">
      <div class="exp-head" data-section-head>
        <span class="eyebrow" data-reveal data-head="label">{t.experience.label}</span>
        <h2 class="h2" data-reveal data-head="title">{t.experience.title}</h2>
      </div>
      <ol class="timeline" data-timeline>
        <li class="track" aria-hidden="true"></li>
        <li class="fill" aria-hidden="true" data-timeline-fill></li>
        {t.experience.jobs.map((j) => (
          <li class="job" data-reveal data-job>
            <span class="marker" aria-hidden="true" data-marker></span>
            <div class="job-top" data-reveal data-job-part>
              <h3>{j.role} <span>· {j.company}</span></h3>
              <span class="period mono">{j.period}</span>
            </div>
            <p data-reveal data-job-part>{j.text}</p>
            <ul class="chips">
              {j.tags.map((tag) => <li class="chip" data-reveal data-job-tag>{tag}</li>)}
            </ul>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Stack -->
  <section id="stack" class="section">
    <div class="wrap stack-48">
      <div class="head" data-section-head>
        <span class="eyebrow" data-reveal data-head="label">{t.stack.label}</span>
        <h2 class="h2" data-reveal data-head="title">{t.stack.title}</h2>
      </div>
      <div class="stack-grid" data-stack-grid>
        {t.stack.groups.map(([name, items], i) => (
          <div class="stack-card" data-reveal data-stack-card>
            <div class="stack-card-head"><span class="mono">0{i + 1}</span><h3>{name}</h3></div>
            <ul>
              {items.map((it) => <li class="mono" data-reveal data-stack-item>{it}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- About -->
  <section id="sobre" class="about" data-about>
    <div class="wrap about-inner">
      <div class="about-side">
        <span class="eyebrow" data-reveal data-about-head>{t.about.label}</span>
        <div class="photo" data-photo>
          <img src="/me.webp" alt={t.about.photoAlt} width="383" height="384" loading="lazy" decoding="async" />
        </div>
      </div>
      <div class="about-copy">
        <h2 class="h2" data-reveal data-about-head>{t.about.title}</h2>
        <p class="about-text" data-reveal data-about-text>{t.about.text}</p>
        <p class="about-edu mono" data-reveal data-about-edu>{t.about.education}</p>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section id="contato" class="contact dots" data-contact>
    <div class="contact-glow" aria-hidden="true"></div>
    <div class="wrap contact-inner">
      <div class="contact-head">
        <span class="eyebrow" data-reveal data-contact-head>{t.contact.label}</span>
        <h2 class="contact-title">{words(t.contact.title).map((w, i) => <>{i > 0 && ' '}<span class="mask"><span data-contact-word>{w}</span></span></>)}</h2>
        <p class="lead contact-text" data-reveal data-contact-text>{t.contact.text}</p>
      </div>
      <div class="contact-grid">
        <a href="mailto:paulobarbosacode@gmail.com" class="contact-card primary" data-reveal data-contact-link>
          <span class="cc"><span class="cc-k">{t.contact.email}</span><span class="cc-v mono">paulobarbosacode@gmail.com</span></span>
          <svg class="cc-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </a>
        <a href="https://www.linkedin.com/in/paulobarbosa-dev/" class="contact-card" target="_blank" rel="noopener" data-reveal data-contact-link>
          <span class="cc"><span class="cc-k">LinkedIn</span><span class="cc-v mono">/in/paulobarbosa-dev</span></span>
          <svg class="cc-arrow diag" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M8 7h9v9"></path></svg>
        </a>
        <a href="https://github.com/paulobarbosa-dev" class="contact-card" target="_blank" rel="noopener" data-reveal data-contact-link>
          <span class="cc"><span class="cc-k">GitHub</span><span class="cc-v mono">paulobarbosa-dev</span></span>
          <svg class="cc-arrow diag" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M8 7h9v9"></path></svg>
        </a>
        <a href={t.resumeFile} class="contact-card" download data-reveal data-contact-link>
          <span class="cc"><span class="cc-k">{t.ui.resume}</span><span class="cc-v mono">{t.contact.resumeValue}</span></span>
          <svg class="cc-arrow down" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12M7 10l5 5 5-5M5 21h14"></path></svg>
        </a>
      </div>
    </div>
  </section>
</main>

<footer class="footer">
  <div class="wrap footer-inner mono">
    <span>© 2026 Paulo Barbosa</span>
    <span>{t.footer.built}</span>
  </div>
</footer>

<script>
  import '../scripts/motion'
</script>

<style>
  /* Hero */
  .hero {
    position: relative;
    overflow: hidden;
    padding: clamp(64px, 8vw, 104px) 0 clamp(72px, 8vw, 112px);
  }
  .hero-glow {
    position: absolute;
    top: -160px;
    right: -120px;
    width: 760px;
    height: 620px;
    background: radial-gradient(closest-side, var(--glow), rgba(109, 93, 252, 0));
    pointer-events: none;
  }
  .hero-fade {
    position: absolute;
    inset: 0;
    background: linear-gradient(transparent 60%, var(--bg) 100%);
    pointer-events: none;
  }
  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr));
    gap: clamp(48px, 6vw, 80px);
    align-items: center;
  }
  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 28px;
  }
  .hero-titles {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .hello {
    margin: 0;
    font-size: 20px;
    color: var(--muted);
  }
  .h1 {
    margin: 0;
    font-size: clamp(44px, 6.2vw, 80px);
    line-height: 1;
    font-weight: 700;
    letter-spacing: -0.035em;
    color: var(--strong);
  }
  .h1-line {
    display: block;
  }
  .h1-line.accent {
    color: var(--accent-2);
  }
  .hero-sub {
    margin: 0;
    max-width: 540px;
    font-size: 18px;
    line-height: 1.6;
    color: var(--muted);
  }
  .hero-sub span {
    color: var(--text);
  }
  .ctas {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .btn {
    height: 48px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 0 22px;
    border-radius: 12px;
    font-size: 15px;
    text-decoration: none;
    transition:
      transform 200ms,
      background-color 200ms,
      box-shadow 200ms,
      border-color 200ms;
  }
  .btn-primary {
    background: var(--accent);
    color: #fff;
    font-weight: 600;
  }
  .btn-primary:hover {
    background: #7b6cff;
    box-shadow: 0 10px 30px -10px rgba(109, 93, 252, 0.8);
    transform: translateY(-1px);
  }
  .btn-ghost {
    border: 1px solid var(--border-3);
    color: var(--text);
    font-weight: 500;
  }
  .btn-ghost:hover {
    border-color: var(--accent-2);
    transform: translateY(-1px);
  }
  /* Marquee */
  .marquee {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: var(--band);
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .marquee-track {
    display: flex;
    width: max-content;
    padding: 22px 0;
    white-space: nowrap;
    font-size: 15px;
    color: var(--muted);
  }
  .marquee-group {
    display: flex;
    gap: 28px;
    padding-right: 28px;
  }
  .sep {
    color: var(--accent);
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee {
      overflow-x: auto;
    }
    .marquee-group[aria-hidden] {
      display: none;
    }
  }

  /* Impact */
  .stack-48 {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }
  .impact-title {
    margin: 0;
    max-width: 720px;
    font-size: clamp(32px, 4vw, 48px);
    line-height: 1.08;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--strong);
  }
  .impact-title span {
    color: var(--accent-2);
  }
  .impact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr));
    gap: 16px;
  }
  .impact-card {
    padding: 24px 22px 26px;
    border-radius: 16px;
    border: 1px solid var(--border);
    background: var(--surface);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 12px 16px;
  }
  .num {
    flex: 0 0 auto;
    font-size: clamp(36px, 10vw, 46px);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--strong);
    font-variant-numeric: tabular-nums;
  }
  .num b {
    font-weight: 500;
    color: var(--accent-2);
  }
  .num .was {
    color: var(--faint);
  }
  .num small {
    font-size: 20px;
    letter-spacing: 0;
    color: var(--muted);
  }
  .num em {
    font-style: normal;
    font-size: 28px;
  }
  .nowrap {
    white-space: nowrap;
  }
  .desc {
    flex: 1 1 140px;
    font-size: 14.5px;
    line-height: 1.45;
    color: var(--muted);
  }

  /* Projects */
  .projects {
    padding-bottom: clamp(96px, 9vw, 128px);
  }
  .projects-inner {
    display: flex;
    flex-direction: column;
    gap: clamp(40px, 5vw, 64px);
  }
  .head {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .project {
    position: relative;
    border-radius: 24px;
    border: 1px solid var(--border);
    background: linear-gradient(var(--card-from), var(--card-to));
    padding: clamp(24px, 3.4vw, 44px);
    display: flex;
    flex-wrap: wrap;
    gap: clamp(32px, 4vw, 56px);
    align-items: center;
    transform-style: preserve-3d;
    will-change: transform;
  }
  .project-glow {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    opacity: 0;
    transition: opacity 400ms;
    background: radial-gradient(420px circle at var(--mx, 50%) var(--my, 50%), rgba(109, 93, 252, 0.16), transparent 60%);
  }
  .project:hover .project-glow {
    opacity: 1;
  }
  .project-copy {
    position: relative;
    flex: 1 1 380px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .kind {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 12.5px;
    color: var(--dim);
  }
  .kind .n {
    color: var(--accent-2);
  }
  .dash {
    width: 24px;
    height: 1px;
    background: rgba(169, 163, 255, 0.3);
  }
  .project h3 {
    margin: 0;
    font-size: clamp(30px, 3.2vw, 40px);
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--strong);
  }
  .project-desc {
    margin: 0;
    font-size: 16.5px;
    line-height: 1.65;
    color: var(--muted);
  }
  .decisions {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .decisions-label {
    font-size: 11.5px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--dim);
  }
  .decisions ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .decisions li {
    display: flex;
    gap: 14px;
    font-size: 15px;
    line-height: 1.55;
    color: var(--body2);
  }
  .arrow {
    color: var(--accent);
    font-size: 13px;
    padding-top: 2px;
  }
  .links {
    display: flex;
    gap: 20px;
    font-size: 14.5px;
    font-weight: 500;
  }
  .link {
    position: relative;
    display: flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    color: var(--text);
    text-decoration: none;
  }
  .link::before,
  .link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 8px;
    height: 1px;
    background: rgba(169, 163, 255, 0.25);
  }
  .link::after {
    background: var(--accent-2);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 250ms ease;
  }
  .link:hover::after {
    transform: scaleX(1);
  }
  .link :global(svg) {
    transition: transform 250ms ease;
  }
  .link:hover :global(svg) {
    transform: translate(2px, -2px);
  }
  .media {
    position: relative;
    flex: 1.25 1 440px;
    min-width: 0;
    border-radius: 16px;
    border: 1px solid rgba(169, 163, 255, 0.14);
    background-color: var(--frame);
    overflow: hidden;
  }
  .browser-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--line);
    font-size: 11.5px;
    color: var(--faint);
    position: relative;
    z-index: 1;
    background: var(--frame);
  }
  .browser-bar .win {
    display: flex;
    gap: 6px;
  }
  .browser-bar .win span {
    width: 9px;
    height: 9px;
    border-radius: 999px;
    background: var(--marker-off);
  }
  .url {
    flex: 1;
    text-align: center;
    padding: 4px 10px;
    border-radius: 6px;
    background: rgba(169, 163, 255, 0.06);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .browser-shot {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--frame-inner);
  }
  .browser-shot img {
    width: 100%;
    height: calc(100% + 80px);
    margin-top: -40px;
    object-fit: cover;
    object-position: top;
    transition: scale 400ms ease;
  }
  .project:hover .browser-shot img {
    scale: 1.03;
  }
  .phones {
    aspect-ratio: 16 / 11;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(14px, 2.4vw, 28px);
    padding: 24px;
  }
  .phone {
    width: 30%;
    max-width: 190px;
    aspect-ratio: 9 / 19.5;
    border-radius: clamp(14px, 2vw, 26px);
    border: 1px solid rgba(169, 163, 255, 0.2);
    background: var(--frame-inner);
